# ============================================================
# CineVault Backend - Environment Variables Example
# ============================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to Git.
# ============================================================

# --- Database ---
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# --- Admin Account Bootstrap ---
# The admin account is created on first startup if it doesn't exist.
# Set a strong password here. It will be BCrypt-hashed before storage.
ADMIN_EMAIL=your.gmail@gmail.com
ADMIN_PASSWORD=YourStrongAdminPassword123!
ADMIN_NAME=CineVault Administrator

# --- JWT Configuration ---
# Generate a secure base64-encoded secret (at least 32 bytes).
# Example: openssl rand -base64 32
JWT_SECRET=replace_with_your_base64_encoded_secret_key_at_least_32_bytes
JWT_EXPIRATION_MS=86400000
