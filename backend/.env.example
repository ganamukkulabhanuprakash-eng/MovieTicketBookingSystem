# ============================================================
# CineVault Backend - Environment Variables Example
# ============================================================
# COPY this file to a local .env or set these as system
# environment variables before starting the backend.
# NEVER commit real credentials to Git.
# ============================================================

# MySQL database username (default: root for local dev)
DB_USERNAME=root

# MySQL database password
# Set this to your actual MySQL root/user password
DB_PASSWORD=your_mysql_password_here
